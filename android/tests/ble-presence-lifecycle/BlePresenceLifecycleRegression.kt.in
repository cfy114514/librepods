private const val TAG = "BlePresenceRegression"
private const val PEER = "AA:BB:CC:DD:EE:FF"
private const val OTHER = "11:22:33:44:55:66"
private const val MODE_PRIVATE = 0
private annotation class SuppressLint(vararg val names: String)
private annotation class RequiresApi(val api: Int)
private object Build { object VERSION_CODES { const val R = 30 } }
private object Log { fun d(tag: String, message: String) = Unit; fun w(tag: String, message: String, error: Exception) = Unit }
class BluetoothDevice(val address: String)
private class BluetoothSocket(val remoteDevice: BluetoothDevice, var isConnected: Boolean = true)
class BluetoothProfile(val id: Int) {
    var connections = 0
    var policies = 0
    var onPolicy: (() -> Unit)? = null
    var policyResult = true
    var connectResult = true
    var policyFailure = false
    var connectFailure = false
    fun setConnectionPolicy(device: BluetoothDevice, policy: Int): Boolean {
        policies++; onPolicy?.invoke()
        if (policyFailure) error("Injected policy failure")
        return policyResult
    }
    fun connect(device: BluetoothDevice): Boolean {
        connections++
        if (connectFailure) error("Injected connect failure")
        return connectResult
    }
    fun getConnectionState(device: BluetoothDevice) = STATE_CONNECTED
    companion object { const val A2DP = 2; const val HEADSET = 1; const val STATE_CONNECTED = 2 }
}
private class BluetoothAdapter {
    val bondedDevices = setOf(BluetoothDevice(PEER))
    fun getRemoteDevice(address: String) = BluetoothDevice(address)
    companion object {
        fun checkBluetoothAddress(address: String) = address.count { it == ':' } == 5
        const val ACTION_STATE_CHANGED = "adapter"; const val EXTRA_STATE = "state"
        const val STATE_ON = 12; const val STATE_OFF = 10; const val ERROR = -1
    }
}
private class BluetoothManager { val adapter = BluetoothAdapter() }
private object BluetoothConnectionManager { var aacpSocket: BluetoothSocket? = null }
private open class Context {
    val applicationContext: Context get() = this
    val deniedPermissions = mutableSetOf<String>()
    var permissionFailure = false
    var permissionHook: (() -> Unit)? = null
    fun checkSelfPermission(permission: String): Int {
        permissionHook?.invoke()
        if (permissionFailure) error("Injected permission lookup failure")
        return if (permission in deniedPermissions) -1 else PackageManager.PERMISSION_GRANTED
    }
    fun <T> getSystemService(type: Class<T>): T = type.cast(BluetoothManager())
}
private object PackageManager { const val PERMISSION_GRANTED = 0 }
private object ServiceManager { var current: AirPodsService? = null; fun getService() = current }
private object Dispatchers { object Main { val immediate = Any() } }
@OptIn(InternalCoroutinesApi::class)
private class TestClock : CoroutineDispatcher(), Delay {
    private class Event(val at: Long, val id: Long, val block: Runnable) { var cancelled = false }
    private val events = java.util.PriorityQueue<Event>(compareBy({ it.at }, { it.id }))
    private var now = 0L
    private var nextId = 0L
    private fun schedule(after: Long, block: Runnable): DisposableHandle {
        val event = Event(now + after, ++nextId, block)
        events.add(event)
        return DisposableHandle { event.cancelled = true }
    }
    override fun dispatch(context: CoroutineContext, block: Runnable) { schedule(0, block) }
    override fun scheduleResumeAfterDelay(timeMillis: Long, continuation: CancellableContinuation<Unit>) {
        val timer = schedule(timeMillis, Runnable { continuation.resume(Unit) })
        continuation.invokeOnCancellation { timer.dispose() }
    }
    override fun invokeOnTimeout(timeMillis: Long, block: Runnable, context: CoroutineContext) = schedule(timeMillis, block)
    fun advanceBy(milliseconds: Long) {
        val target = now + milliseconds
        var steps = 0
        while (events.peek()?.let { it.at <= target } == true) {
            check(++steps <= 100) { "Unexpected timer retry loop" }
            val event = events.remove()
            now = event.at
            if (!event.cancelled) event.block.run()
        }
        now = target
    }
}
private class MainQueue : CoroutineScope {
    val clock = TestClock()
    override val coroutineContext = SupervisorJob() + clock
    var beforeLaunch: (() -> Unit)? = null
    fun launch(dispatcher: Any, action: () -> Unit) { beforeLaunch?.also { beforeLaunch = null }?.invoke(); action() }
}
private class ResourceState {
    var isClosed = false
    private val resources = mutableListOf<java.io.Closeable>()
    fun <T> track(resource: T): T { if (resource is java.io.Closeable) resources += resource; return resource }
    fun release(resource: Any) = Unit
    fun close() { isClosed = true; resources.forEach { it.close() } }
}
private class Resettable { var resets = 0; fun clear() { resets++ }; fun reset() { resets++ } }
private class HeadTrackingSession {
    class Ticket(val id: Long)
    fun capture() = Ticket(1)
    fun currentStart(id: Long) = if (id == 1L) Ticket(id) else null
}
private class WorkQueue<K, V> { var isClosed = false; var last: V? = null; fun offer(key: K, value: V) { last = value } }
private class AacpState {
    private var session = 0L
    fun disconnected() { session++ }
    fun captureDeviceSession() = session
    fun isCurrentDeviceSession(value: Long) = session == value
}
private class Preferences { var address = PEER; fun getString(key: String, fallback: String) = if (key == "mac_address") address else fallback }
private class Configuration {
    var bleOnlyMode = false
    var takeoverWhenDisconnected = true
    var takeoverWhenMediaStart = true
    var takeoverWhenRingingCall = true
    val deviceName = "AirPods"
}
private class Battery
private class BatteryNotification {
    var invalidations = 0
    fun invalidate() { invalidations++ }
    fun setBatteryDirect(left: Int, leftCharging: Boolean, right: Int, rightCharging: Boolean, case: Int, caseCharging: Boolean) = Unit
}
private class BatteryHistory { var flushes = 0; fun flush() { flushes++ } }
private class BLEManager {
    class AirPodsStatus(val connectionState: String = "Disconnected") {
        val leftBattery: Int? = 80; val rightBattery: Int? = 80; val caseBattery: Int? = 60
        val isLeftCharging = false; val isRightCharging = false; val isCaseCharging = false
        fun hasSameBatteryAs(other: AirPodsStatus) = false
    }
    interface AirPodsStatusListener {
        fun onBatteryObserved(device: AirPodsStatus)
        fun onDeviceStatusChanged(device: AirPodsStatus, previousStatus: AirPodsStatus?)
        fun onBroadcastFromNewAddress(device: AirPodsStatus)
        fun onLidStateChanged(lidOpen: Boolean)
        fun onEarStateChanged(device: AirPodsStatus, leftInEar: Boolean, rightInEar: Boolean)
        fun onBatteryChanged(device: AirPodsStatus)
        fun onDeviceDisappeared()
    }
}
private class ConnectionNotice(val name: String, val batteries: List<Battery>, val reversed: Boolean,
    val peer: String, val selection: Long, val deviceSession: Long, val socket: BluetoothSocket)
private class NoticeLease {
    var clears = 0
    fun clear() { clears++ }
    fun offer(notice: ConnectionNotice, valid: () -> Boolean) = Unit
}
private open class BroadcastReceiver
private class Watch(val ticket: AudioProfileOwnership.Ticket, val receiver: BroadcastReceiver = BroadcastReceiver()) {
    var closes = 0; fun close() { closes++ }
}
private object MediaController { var pausedWhileTakingOver = false; fun sendPlay() = Unit }
private object AirPodsNotifications { const val AIRPODS_DISCONNECTED = "disconnected" }
private class Intent(val action: String, val state: Int = BluetoothAdapter.STATE_OFF) {
    fun setPackage(name: String) = this
    fun getIntExtra(key: String, fallback: Int) = state
}

private class AirPodsService : Context() {
@@PROFILE_TYPE@@
@@TAKEOVER_TYPE@@
    val serviceResources = ResourceState()
    val serviceScope = MainQueue()
    val config = Configuration()
    val sharedPreferences = Preferences()
    val audioProfileOwnership = AudioProfileOwnership(setOf(BluetoothProfile.A2DP, BluetoothProfile.HEADSET)).apply { select(PEER) }
    val takeoverGeneration = AtomicLong()
    val blePresenceGeneration = AtomicLong()
    val manualConnectionGeneration = AtomicLong()
    val notificationGeneration = AtomicLong()
    val aacpManager = AacpState()
    val batteryNotification = BatteryNotification()
    val headTrackingStartup = Resettable()
    val audioChargingState = Resettable()
    val notificationLease = NoticeLease()
    val headTrackingSession = HeadTrackingSession()
    private val takeoverRequests = WorkQueue<TakeoverAction, TakeoverRequest>()
@@PROFILE_QUEUE@@
@@DEADLINE_FIELD@@
    private val profileActionCurrent = ThreadLocal<() -> Boolean>()
    private val a2dpWatch = AtomicReference<Watch?>()
    // Diagnostic ownership does not replace this harness's actual audio-policy state.
    private val ownedControlObservations = AtomicReference<java.io.Closeable?>()
    private val pending = ArrayDeque<PendingProfileRequests.Ticket<Int>>()
    val profiles = listOf(BluetoothProfile(BluetoothProfile.A2DP), BluetoothProfile(BluetoothProfile.HEADSET))
    val autoSocketGuards = mutableListOf<() -> Boolean>()
    private val manualContinuations = ArrayDeque<() -> Unit>()
    var macAddress = PEER
    var localMac = OTHER
    var device: BluetoothDevice? = BluetoothDevice(PEER)
    var popupShown = true
    val packageName = "regression"
    var disconnectedBecauseReversed = false
    var lastBatterySnapshot: Any? = Any()
    var lastBleBatteryStatus: BLEManager.AirPodsStatus? = null
    lateinit var batteryHistory: BatteryHistory
    var conversationResets = 0
    var widgetUpdates = 0

    init { batteryHistory = BatteryHistory(); ServiceManager.current = this }
    private fun isCurrentControlSocket(socket: BluetoothSocket) = socket === BluetoothConnectionManager.aacpSocket && socket.isConnected
    private fun resetConversation() { conversationResets++ }
    private fun updateBatteryWidget() { widgetUpdates++ }
    private fun recordBleBatteryHistory(status: BLEManager.AirPodsStatus) = Unit
    private fun updateBattery(force: Boolean) = Unit
    private fun showPopup(service: AirPodsService, name: String) = Unit
    // Popup window lifecycle is covered by tests/popup-trigger.
    private fun dismissPopup() { popupShown = false }
    private fun getSharedPreferences(name: String, mode: Int) = sharedPreferences
    private fun sendBroadcast(intent: Intent) = Unit
    private fun enqueueSocketConnection(adapter: BluetoothAdapter, device: BluetoothDevice, manual: Boolean,
        canConnect: () -> Boolean, afterConnect: (() -> Unit)? = null) {
        if (manual) manualContinuations.addLast { afterConnect?.invoke() }
        else autoSocketGuards += canConnect
    }
    private fun registerA2dpConnectionReceiver(target: BluetoothDevice, ticket: AudioProfileOwnership.Ticket, socket: BluetoothSocket): BroadcastReceiver? = null
    private fun acquireAudioProfile(context: Context, ticket: PendingProfileRequests.Ticket<Int>) { pending.addLast(ticket) }
    private fun completeAudioProfileAcquisition(context: Context, adapter: BluetoothAdapter, acquisition: Any) = Unit
    private fun isCurrentProfileAction() = profileActionCurrent.get()?.invoke() != false
    // Keep the real controlled platform query; diagnostic recording is covered separately.
    private fun observedProfileConnectionState(proxy: BluetoothProfile, target: BluetoothDevice, profile: Int) =
        proxy.getConnectionState(target)

@@LISTENER@@
@@PRESENCE_HELPERS@@
@@NOTIFICATION@@
@@TAKEOVER@@
@@CONNECT_TAKEOVER@@
@@SAVED_RECONNECT@@
@@CONNECT@@
@@PROFILE_OFFER@@
@@AUDIO_VALID@@
@@DISCONNECT_AUDIO@@
@@REVOKE@@
@@RETIRE@@
@@WATCH@@

    // Actual adapter branch; scanner/UI/diagnostic collaborators do not retire BLE presence.
    private fun updateBleScanning(enabled: Boolean) = Unit
    private fun invalidateConnectionObservations() = Unit
    fun adapter(enabled: Boolean) {
        val action = BluetoothAdapter.ACTION_STATE_CHANGED
        val intent = Intent(action, if (enabled) BluetoothAdapter.STATE_ON else BluetoothAdapter.STATE_OFF)
@@ADAPTER@@
    }
    fun expire() = bleStatusListener.onDeviceDisappeared()
    fun observeDisconnected() = bleStatusListener.onDeviceStatusChanged(BLEManager.AirPodsStatus(), null)
    fun retireControl() { BluetoothConnectionManager.aacpSocket = null; finishControlDisconnection() }
    fun revoke() = revokeAudioRestore()
    fun selectOther() { macAddress = OTHER; sharedPreferences.address = OTHER; audioProfileOwnership.select(OTHER) }
    fun close() { serviceResources.close() }
    fun publishControl() { BluetoothConnectionManager.aacpSocket = BluetoothSocket(BluetoothDevice(PEER)) }
    fun queueDirect() = connectAudio(this, BluetoothDevice(PEER))
    fun queueRelease() = disconnectAudio(this, BluetoothDevice(PEER))
    fun startSavedReconnect() = reconnectFromSavedMac()
    fun finishSavedReconnect() = manualContinuations.removeFirst().invoke()
    fun queueSavedReconnect() { startSavedReconnect(); finishSavedReconnect() }
    fun captureTakeover(reason: String = "music", manual: Boolean = true, head: Boolean = false): () -> Boolean {
        takeOver(reason, manual, head)
        val request = takeoverRequests.last ?: error("Request was not offered")
        return { takeoverCurrent(request) }
    }
    fun queueTakeover(sourceCurrent: () -> Boolean = { true }, beforeConnect: () -> Unit = {}): Boolean {
        val request = takeoverRequests.last ?: error("No takeover captured")
        return connectAudioForTakeover(request, BluetoothDevice(PEER), request.socket, sourceCurrent, beforeConnect) != null
    }
    fun dispatchProfiles() {
        var deliveries = 0
        while (pending.isNotEmpty()) {
            check(++deliveries <= 12) { "Unexpected profile retry loop" }
            dispatchOneProfile()
        }
    }
    fun dispatchOneProfile(skipAction: Boolean = false) {
        val ticket = pending.removeFirst()
        val requests = profileRequests.take(ticket) ?: return
        val value = profiles.first { it.id == ticket.profile }
        try {
            if (!skipAction) {
@@PROFILE_DISPATCH@@
            }
        } finally { finishProfileOperation(ticket, requests) }
    }
    private fun finishProfileOperation(ticket: PendingProfileRequests.Ticket<Int>, requests: List<AudioProfileRequest>) {
        val operation = Any()
        val adapter = BluetoothAdapter()
        val acquisition = Any()
        val context = this
@@PROFILE_FINISH@@
        onFinished()
    }
    fun rejectOneProfile() { profileRequests.rejected(pending.removeFirst()) }
    fun rejectProfiles() { while (pending.isNotEmpty()) rejectOneProfile() }
    fun connectionCount() = profiles.sumOf { it.connections }
    fun policyCount() = profiles.sumOf { it.policies }
    fun installWatch(ticket: AudioProfileOwnership.Ticket) = Watch(ticket).also(a2dpWatch::set)
}

fun main() {
    var failures = 0
    var total = 0
    fun scenario(name: String, body: (AirPodsService) -> Unit) {
        total++
        BluetoothConnectionManager.aacpSocket = null
        MediaController.pausedWhileTakingOver = false
        try { body(AirPodsService()); println("PASS $name") }
        catch (failure: Throwable) { failures++; println("FAIL $name: ${failure.message}") }
    }
    fun expectBoth(service: AirPodsService) {
        service.dispatchProfiles()
        check(service.connectionCount() == 2 && service.policyCount() == 2) {
            "Expected two profile policy/connect actions, got ${service.policyCount()}/${service.connectionCount()}"
        }
    }
    fun expectProtected(service: AirPodsService) {
        val before = service.autoSocketGuards.size
        service.observeDisconnected()
        check(service.autoSocketGuards.size == before) { "Passive BLE work was admitted over active user audio" }
    }
    fun expectPassiveAllowed(service: AirPodsService) {
        val before = service.autoSocketGuards.size
        service.observeDisconnected()
        check(service.autoSocketGuards.size == before + 1) { "Completed audio request permanently blocked passive work" }
    }

    scenario("fresh BLE status preserves queued direct audio") { service ->
        service.queueDirect(); service.observeDisconnected(); expectBoth(service)
    }
    scenario("fresh BLE status preserves queued manual takeover audio") { service ->
        service.captureTakeover(); check(service.queueTakeover()); service.observeDisconnected(); expectBoth(service)
    }
    scenario("fresh BLE status preserves saved-device reconnect audio") { service ->
        service.queueSavedReconnect(); service.observeDisconnected(); expectBoth(service)
    }
    scenario("first profile completion protects its sibling and final completion permits passive work") { service ->
        service.queueDirect(); service.dispatchOneProfile(); expectProtected(service)
        expectBoth(service); expectPassiveAllowed(service)
        check(service.audioProfileOwnership.beginRestore(PEER)?.profiles == setOf(BluetoothProfile.A2DP, BluetoothProfile.HEADSET))
    }
    scenario("profile queue rejection protects sibling then releases after both reject") { service ->
        service.queueDirect(); service.rejectOneProfile(); expectProtected(service)
        service.rejectProfiles(); expectPassiveAllowed(service)
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    for (outcome in listOf("policy rejection", "connect rejection", "policy exception", "connect exception")) {
        scenario("$outcome settles explicit audio and permits a fresh passive claim") { service ->
            service.profiles.forEach {
                it.policyResult = outcome != "policy rejection"
                it.connectResult = outcome != "connect rejection"
                it.policyFailure = outcome == "policy exception"
                it.connectFailure = outcome == "connect exception"
            }
            service.queueDirect(); service.dispatchOneProfile(); expectProtected(service)
            service.dispatchProfiles(); expectPassiveAllowed(service)
            check(service.policyCount() == 2 && service.connectionCount() == if (outcome == "policy exception") 0 else 2)
        }
    }
    scenario("skipped HEADSET permission does not leave explicit audio permanently active") { service ->
        service.deniedPermissions += "android.permission.MODIFY_PHONE_STATE"
        service.queueDirect(); expectProtected(service); service.dispatchProfiles()
        check(service.connectionCount() == 1 && service.policyCount() == 1)
        expectPassiveAllowed(service)
    }
    scenario("coalesced older requests do not release the newer manual request") { service ->
        service.queueDirect(); service.queueDirect(); expectProtected(service)
        expectBoth(service); expectPassiveAllowed(service)
    }
    scenario("older in-flight completion cannot release a newer manual request") { service ->
        service.queueDirect()
        service.profiles.first().onPolicy = {
            service.profiles.first().onPolicy = null
            service.queueDirect()
        }
        service.dispatchOneProfile(); expectProtected(service)
        service.dispatchProfiles()
        check(service.connectionCount() == 2 && service.policyCount() == 3)
        expectPassiveAllowed(service)
    }
    scenario("stale producer cannot replace newer manual profile requests after permission lookup") { service ->
        service.permissionHook = {
            service.permissionHook = null
            service.queueDirect()
        }
        service.queueDirect()
        expectBoth(service)
        expectPassiveAllowed(service)
    }
    scenario("stale disconnect producer cannot replace newer manual profile requests") { service ->
        service.publishControl()
        service.permissionHook = {
            service.permissionHook = null
            service.queueDirect()
        }
        service.queueRelease()
        expectBoth(service)
    }
    scenario("closing pending profile queue settles active user audio") { service ->
        service.queueDirect(); service.close()
        service.audioProfileOwnership.claim(PEER)
        check(service.audioProfileOwnership.beginRestore(PEER) != null)
        service.dispatchProfiles(); check(service.connectionCount() == 0)
    }
    scenario("actual operation completion settles delivered requests whose actions never started") { service ->
        service.queueDirect(); service.dispatchOneProfile(skipAction = true); expectProtected(service)
        service.dispatchOneProfile(skipAction = true); expectPassiveAllowed(service)
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    scenario("explicit completion preserves its media snapshot without permanently blocking passive work") { service ->
        service.captureTakeover(); check(service.queueTakeover())
        val media = service.audioProfileOwnership.captureMedia(PEER)!!
        expectBoth(service)
        check(service.audioProfileOwnership.isCurrentMedia(media))
        expectPassiveAllowed(service)
    }
    scenario("automatic takeover does not reserve user priority against fresh BLE work") { service ->
        service.captureTakeover(manual = false); check(service.queueTakeover())
        expectPassiveAllowed(service); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    scenario("user disconnect still cancels a saved reconnect before its continuation") { service ->
        service.startSavedReconnect(); service.revoke(); service.finishSavedReconnect(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    scenario("selection change still cancels a saved reconnect before its continuation") { service ->
        service.startSavedReconnect(); service.selectOther(); service.finishSavedReconnect(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    scenario("producer exception retires the explicit ticket before any profile is offered") { service ->
        service.permissionFailure = true
        check(runCatching { service.queueDirect() }.isFailure)
        service.permissionFailure = false
        service.dispatchProfiles(); check(service.connectionCount() == 0 && service.policyCount() == 0)
        expectPassiveAllowed(service)
    }
    scenario("takeover pre-connect exception abandons its unoffered explicit ticket") { service ->
        service.captureTakeover()
        check(runCatching { service.queueTakeover(beforeConnect = { error("Injected producer failure") }) }.isFailure)
        service.dispatchProfiles(); check(service.connectionCount() == 0 && service.policyCount() == 0)
        expectPassiveAllowed(service)
    }
    scenario("ten-second production deadline revokes missing callbacks without retrying") { service ->
        service.queueDirect(); service.serviceScope.clock.advanceBy(9_999); expectProtected(service)
        service.serviceScope.clock.advanceBy(1)
        service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
        check(service.autoSocketGuards.isEmpty()) { "Timeout retried automatically" }
        expectPassiveAllowed(service)
    }
    scenario("deadline revokes an unfinished sibling after the first profile completed") { service ->
        service.queueDirect(); service.dispatchOneProfile()
        service.serviceScope.clock.advanceBy(10_000); service.dispatchProfiles()
        check(service.connectionCount() == 1 && service.policyCount() == 1)
        expectPassiveAllowed(service)
    }
    scenario("timeout during policy execution prevents its late connect continuation") { service ->
        service.queueDirect()
        service.profiles.first().onPolicy = { service.serviceScope.clock.advanceBy(10_000) }
        service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 1)
        expectPassiveAllowed(service)
    }
    scenario("old deadline cannot retire a newer explicit request") { service ->
        service.queueDirect(); service.serviceScope.clock.advanceBy(5_000)
        service.queueDirect(); service.serviceScope.clock.advanceBy(5_000); expectProtected(service)
        service.serviceScope.clock.advanceBy(4_999); expectProtected(service)
        service.serviceScope.clock.advanceBy(1); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
        expectPassiveAllowed(service)
    }
    scenario("completed request remains a valid media snapshot beyond its former deadline") { service ->
        service.queueDirect()
        val media = service.audioProfileOwnership.captureMedia(PEER)!!
        expectBoth(service); service.serviceScope.clock.advanceBy(20_000)
        check(service.audioProfileOwnership.isCurrentMedia(media))
        expectPassiveAllowed(service)
    }

    scenario("explicit selection begun after BLE expiry still connects") { service ->
        service.expire(); service.captureTakeover(); check(service.queueTakeover()); expectBoth(service)
    }
    scenario("BLE expiry between selection snapshot and explicit ticket keeps request valid") { service ->
        service.captureTakeover()
        var expired = false
        check(service.queueTakeover(sourceCurrent = {
            if (!expired) { expired = true; service.expire() }
            true
        })) { "BLE expiry cancelled explicit selection" }
        expectBoth(service)
    }
    scenario("BLE expiry after explicit ticket but before profile offer preserves ownership") { service ->
        service.captureTakeover()
        check(service.queueTakeover(beforeConnect = { service.expire() }))
        expectBoth(service)
    }
    scenario("BLE expiry after profile offer preserves direct manual audio callbacks") { service ->
        service.queueDirect(); service.expire(); service.expire(); expectBoth(service)
    }
    scenario("BLE expiry after profile offer preserves manual takeover callbacks") { service ->
        service.captureTakeover(); check(service.queueTakeover()); service.expire(); expectBoth(service)
    }
    scenario("BLE expiry during accepted profile policy still permits explicit connect") { service ->
        service.queueDirect(); service.profiles.first().onPolicy = { service.expire() }; expectBoth(service)
    }
    scenario("BLE expiry clears presentation without audio or head tracking retirement") { service ->
        val media = service.audioProfileOwnership.captureMedia(PEER)!!
        val generation = service.takeoverGeneration.get()
        service.expire()
        check(service.lastBatterySnapshot == null && service.batteryNotification.invalidations == 1)
        check(service.notificationLease.clears == 1 && service.batteryHistory.flushes == 1 && service.widgetUpdates == 1)
        check(service.notificationGeneration.get() == 1L)
        check(service.takeoverGeneration.get() == generation && service.audioProfileOwnership.isCurrentMedia(media))
        check(service.conversationResets == 0 && service.audioChargingState.resets == 0 && service.headTrackingStartup.resets == 0)
    }
    scenario("live control connection is immune to BLE disappearance") { service ->
        service.publishControl(); service.queueDirect()
        val generation = service.takeoverGeneration.get()
        val presence = service.blePresenceGeneration.get()
        service.expire()
        check(service.notificationGeneration.get() == 0L && service.lastBatterySnapshot != null)
        check(service.takeoverGeneration.get() == generation && service.blePresenceGeneration.get() == presence)
        expectBoth(service)
    }
    scenario("real control retirement still rejects queued explicit callbacks") { service ->
        service.publishControl(); service.queueDirect(); service.retireControl(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
        check(service.conversationResets == 1 && service.headTrackingStartup.resets == 1)
    }
    scenario("real control retirement still closes stale ownership watch") { service ->
        val ticket = service.audioProfileOwnership.beginExplicitConnect(PEER)
        val watch = service.installWatch(ticket)
        service.retireControl()
        check(!service.audioProfileOwnership.isCurrent(ticket) && watch.closes == 1)
    }
    scenario("user revoke still rejects queued explicit work") { service ->
        service.queueDirect(); service.revoke(); service.expire(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    scenario("changed peer still rejects queued explicit work") { service ->
        service.queueDirect(); service.selectOther(); service.expire(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
    }
    scenario("closed service still rejects queued explicit work") { service ->
        service.queueDirect(); service.close(); service.expire(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
        check(service.notificationGeneration.get() == 0L)
    }
    scenario("replaced service ignores late BLE expiry") { service ->
        val generation = service.blePresenceGeneration.get()
        ServiceManager.current = null; service.expire()
        check(service.blePresenceGeneration.get() == generation && service.notificationGeneration.get() == 0L)
    }
    for (reason in listOf("music", "call")) {
        scenario("socketless automatic $reason takeover expires and fresh request succeeds") { service ->
            val stale = service.captureTakeover(reason, manual = false)
            check(stale()); service.expire(); check(!stale()) { "Expired automatic takeover remained current" }
            val fresh = service.captureTakeover(reason, manual = false)
            check(fresh()) { "New automatic request was permanently blocked" }
        }
    }
    for (kind in listOf("manual", "reverse", "head")) {
        scenario("socketless explicit $kind takeover survives BLE expiry") { service ->
            val current = service.captureTakeover(if (kind == "reverse") "reverse" else "music",
                manual = kind == "manual", head = kind == "head")
            check(current()); service.expire(); check(current()) { "Explicit $kind request was revoked by BLE expiry" }
        }
    }
    scenario("connected automatic takeover survives BLE expiry") { service ->
        service.publishControl(); val current = service.captureTakeover(manual = false)
        service.expire(); check(current())
    }
    scenario("actual BLE auto socket guard expires and fresh advertisement remains eligible") { service ->
        service.observeDisconnected()
        val stale = service.autoSocketGuards.single()
        check(stale()); service.expire(); check(!stale()) { "BLE-expired socket attempt remained eligible" }
        service.observeDisconnected()
        check(service.autoSocketGuards.size == 2 && service.autoSocketGuards.last()())
        check(!stale())
    }
    scenario("expired automatic profile callbacks retire and fresh automatic audio can connect") { service ->
        service.captureTakeover(manual = false); check(service.queueTakeover())
        service.expire(); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0)
        service.captureTakeover(manual = false); check(service.queueTakeover()); expectBoth(service)
    }
    scenario("BLE expiry clears speculative claims without revoking accepted release grants") { service ->
        val ownership = service.audioProfileOwnership
        ownership.claim(PEER)
        val release = ownership.beginRelease(PEER, restorable = true)!!
        check(ownership.applyReleasePolicy(release, BluetoothProfile.A2DP) { true })
        service.expire()
        val restore = ownership.beginRestore(PEER)!!
        check(restore.profiles == setOf(BluetoothProfile.A2DP) && restore.releasedProfiles == setOf(BluetoothProfile.A2DP))
    }
    scenario("queued claim-only restore loses eligibility at expiry") { service ->
        val ownership = service.audioProfileOwnership
        ownership.claim(PEER)
        val restore = ownership.beginRestore(PEER)!!
        service.expire()
        var actions = 0
        restore.profiles.forEach { profile -> ownership.withCurrent(restore, profile) { actions++ } }
        check(actions == 0 && ownership.beginRestore(PEER) == null)
    }
    scenario("adapter OFF retires queued BLE automatic socket source") { service ->
        service.observeDisconnected()
        val stale = service.autoSocketGuards.single()
        check(stale()); service.adapter(false)
        check(!stale()) { "Adapter-off scan retirement preserved obsolete BLE automatic source" }
        check(service.audioProfileOwnership.beginRestore(PEER) == null) { "Adapter-off left speculative audio claim" }
        service.adapter(true); service.observeDisconnected()
        check(service.autoSocketGuards.last()() && !stale())
    }
    scenario("adapter OFF retires queued socketless automatic profile work") { service ->
        service.captureTakeover(manual = false); check(service.queueTakeover())
        service.adapter(false); service.dispatchProfiles()
        check(service.connectionCount() == 0 && service.policyCount() == 0) { "Adapter-off dispatched stale automatic audio" }
    }
    scenario("adapter OFF preserves explicit audio request") { service ->
        service.queueDirect(); service.adapter(false); expectBoth(service)
    }
    scenario("adapter OFF preserves live control source independently of BLE") { service ->
        service.publishControl(); val current = service.captureTakeover(manual = false)
        val generation = service.blePresenceGeneration.get()
        service.adapter(false)
        check(current() && service.blePresenceGeneration.get() == generation)
    }
    scenario("real socket publication protects the outer-guard to manager-lock gap") {
        me.kavishdevar.librepods.services.publication.runPublicationRaceRegressions()
    }
    println("$total scenarios, $failures failures")
    check(failures == 0) { "BLE presence lifecycle regression failed" }
}
